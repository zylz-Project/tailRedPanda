CONFIG_IDF_TARGET_ESP32S3=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_ESPTOOLPY_HEADER_FLASHSIZE_UPDATE=y

# Custom partition table (12MB factory app partition)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

CONFIG_ESP_WIFI_SSID="CatRecorder"
CONFIG_ESP_WIFI_PASSWORD="12345678"
CONFIG_ESP_WIFI_CHANNEL=1
CONFIG_ESP_WIFI_MAX_CONN=4
CONFIG_LWIP_MAX_SOCKETS=16

# Realtime audio does JSON/base64 work while driving I2S; match the reference
# project's 240 MHz CPU setting to keep the decoder/response task schedulable.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=240

# Realtime TTS chunks are about 5 KB after base64 expansion. A larger TCP
# window prevents the server from stalling after nearly every audio chunk.
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=32768
CONFIG_LWIP_TCP_WND_DEFAULT=32768
CONFIG_LWIP_TCP_RECVMBOX_SIZE=16

# RX and TX must not share the websocket client's single legacy lock. Without
# this, an incoming frame can make microphone/control sends time out repeatedly.
CONFIG_ESP_WS_CLIENT_SEPARATE_TX_LOCK=y
CONFIG_ESP_WS_CLIENT_TX_LOCK_TIMEOUT_MS=500

# Increase stack sizes
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
CONFIG_HTTPD_TASK_STACK_SIZE=8192
CONFIG_HTTPD_MAX_REQ_HANDLERS=20

# Increase interrupt watchdog timeout (prevents SPI Flash + I2S conflict crashes)
CONFIG_INT_WDT_TIMEOUT_MS=500
CONFIG_ESP_INT_WDT_TIMEOUT_MS=500

# PSRAM (ESP32-S3-WROOM N16R8, quad). IGNORE_NOTFOUND keeps booting if absent.
CONFIG_SPIRAM=y
# CONFIG_SPIRAM_MODE_QUAD is not set
CONFIG_SPIRAM_TYPE_AUTO=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=2048
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768

# This application has several long-lived audio/HTTP tasks. Let mbedTLS use the
# normal allocator: allocations larger than the 2KB threshold above go to
# PSRAM, while small latency-sensitive objects can remain internal.
# CONFIG_MBEDTLS_INTERNAL_MEM_ALLOC is not set
CONFIG_MBEDTLS_DEFAULT_MEM_ALLOC=y

# Smaller TLS buffers (reduces heap pressure for WSS chat)
CONFIG_MBEDTLS_SSL_VARIABLE_BUFFER_LENGTH=y
