CONFIG_IDF_TARGET_ESP32S3=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_ESPTOOLPY_HEADER_FLASHSIZE_UPDATE=y

# Custom partition table (12MB factory app partition)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

CONFIG_ESP_WIFI_SSID="YOUR_WIFI_SSID"
CONFIG_ESP_WIFI_PASSWORD="YOUR_WIFI_PASSWORD"
CONFIG_ESP_WIFI_CHANNEL=1
CONFIG_ESP_WIFI_MAX_CONN=4
CONFIG_LWIP_MAX_SOCKETS=16

# Increase stack sizes
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
CONFIG_HTTPD_TASK_STACK_SIZE=8192
CONFIG_HTTPD_MAX_REQ_HANDLERS=20

# Increase interrupt watchdog timeout (prevents SPI Flash + I2S conflict crashes)
CONFIG_INT_WDT_TIMEOUT_MS=500
CONFIG_ESP_INT_WDT_TIMEOUT_MS=500
